# Порт HTTP-сервера
PORT=3000
# Путь к файлу базы данных SQLite
DB_PATH=./data/team-alert.db
# Команды, создаваемые при первом запуске (через запятую)
SEED_TEAMS=Команда 1,Команда 2,Команда 3

# Push-уведомления (Expo Push Service). Токен доступа нужен,
# только если в проекте Expo включена "Enhanced Push Security".
EXPO_ACCESS_TOKEN=

# SMS-провайдер: console | smsru | twilio
SMS_PROVIDER=console
# sms.ru
SMSRU_API_ID=
SMSRU_FROM=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
